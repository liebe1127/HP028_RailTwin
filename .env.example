# .env.example — 이 파일을 복사하여 .env 로 저장 후 실제 값을 채워주세요.
# cp .env.example .env
#
# ── 네이버클라우드 / Docker 시연 ───────────────────────────
# - DEMO_MODE=true면 가상 센서, false면 Mosquitto MQTT 입력만 사용합니다.
# - 웹 대시보드: https://223.130.128.198:8000/dashboard
# - Unity·표 WebSocket: wss://223.130.128.198:8000/ws
# - ESP32 MQTT: mqtt://223.130.128.198:1883
# - 자세한 배포: docs/ncp-docker-deploy.md

# ── ESP32-C3 → Mosquitto MQTT 센서 업링크 ───────────────
# 세 비밀번호는 각각 충분히 긴 임의 문자열로 바꿉니다.
# 좌·우 비밀번호는 각 보드의 firmware secrets.h와 맞춰야 합니다.
# FastAPI가 같은 서버 Mosquitto에 붙을 때. Docker면 compose가 host를 mosquitto로 덮어씁니다.
MQTT_LEFT_PASSWORD=replace-with-left-node-password
MQTT_RIGHT_PASSWORD=replace-with-right-node-password
MQTT_BACKEND_PASSWORD=replace-with-backend-password
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=railtwin-backend
MQTT_TLS=false
MQTT_CLIENT_ID=railtwin-backend
MQTT_TOPIC_PREFIX=rail/v1/nodes
MQTT_KEEPALIVE_SECONDS=30
MQTT_MAX_PAYLOAD_BYTES=65536
# 실제 ESP32 연결 시 false, 합성 시연 시 true
# NCP 실기 대시보드: DEMO_MODE=false
DEMO_MODE=true

# 중간 시연: left ESP32가 없으면 right 데이터를 /ws 의 left에도 복제 (Unity·대시보드)
MIRROR_RIGHT_TO_LEFT=true

# ── InfluxDB 연결 정보 ────────────────────────────────────
# InfluxDB UI → Load Data → API Tokens 에서 토큰 발급
# 토큰 또는 조직이 비어 있으면 DB 쓰기만 비활성화되고 API/WebSocket은 동작
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=your-influxdb-api-token-here
INFLUX_ORG=your-org-name
INFLUX_BUCKET=crane_data
# InfluxDB 첫 기동과 Grafana 로그인. 서버 .env에 없으면 설치 스크립트가 만들어 넣는다.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=replace-with-long-password
GRAFANA_ADMIN_USER=railtwin
GRAFANA_ADMIN_PASSWORD=replace-with-long-password
GRAFANA_ROOT_URL=https://223.130.128.198:8000/grafana/

# ── 디바이스 식별자 fallback ──────────────────────────────
# 실제 ESP32 payload의 device_id가 우선입니다.
DEVICE_ID=rail-sensor

# ── 레일 구간 이상 히트맵 (웹·Unity WebGL) ───────────────
# 실물 레일 180 cm (60 cm 각파이프 3개, Unity 모델과 같음), 구간 36개 = 50 mm
RAIL_LENGTH_CM=180
RAIL_SEGMENT_COUNT=36
# 출발 시 뒷바퀴의 레일 위치(mm). 첫 주행 분석 전에만 쓰고, 그 뒤에는 이음부 기준으로 자동 보정된다.
# 40 = 9/28 실측 역산(출발 시 센서 289 mm − 센서 오프셋 250). 줄자 실측값 − 250 으로 바꾼다.
RAIL_ENCODER_ZERO_MM=40

# ── 판정 엔진 (docs/ai-judge.md) ─────────────────────────
# 단계적으로 켠다: v1(기본, 논문 검증본) → v2(판정 규칙 수정안) → v2 + AI(1D CNN 크기 추정)
RAIL_JUDGE=v1
RAIL_AI=0
# 감속·정지를 주행 분석 결과에서 내고 앞 구간을 미리 볼지. 비워 두면 v2 일 때만 켠다.
# RAIL_MOTION_FROM_PASS=1
# RAIL_MOTION_LOOKAHEAD=2
