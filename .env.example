# .env.example — 이 파일을 복사하여 .env 로 저장 후 실제 값을 채워주세요.
# cp .env.example .env
#
# ── 네이버클라우드 / Docker 시연 ───────────────────────────
# - ESP32(시리얼)가 없으면 자동으로 demo_mode (가상 센서)로 동작합니다.
# - 팀원 Godot: wss://hp028-railtwin.duckdns.org/ws
# - 브라우저 헬스: https://hp028-railtwin.duckdns.org/
# - HTTPS(Docker): docker compose -f docker-compose.https.yml up -d --build
# - HTTPS(호스트): sudo bash scripts/run_https.sh
# - 자세한 배포: docs/ncp-docker-deploy.md

# ── 시리얼 포트 설정 ──────────────────────────────────────
# 로컬: $ ls /dev/cu.*  로 ESP32 포트 확인
# 클라우드 Docker: 아래 값이 없어도 되며, 포트가 없으면 demo_mode
SERIAL_PORT=/dev/cu.usbmodem1101
BAUD_RATE=115200

# ── InfluxDB 연결 정보 ────────────────────────────────────
# InfluxDB UI → Load Data → API Tokens 에서 토큰 발급
# 클라우드 시연만 할 때는 비워 두어도 API/WebSocket은 동작 (쓰기만 실패 로그)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-api-token-here
INFLUX_ORG=your-org-name
INFLUX_BUCKET=crane_data

# ── 디바이스 식별자 (InfluxDB Tag) ───────────────────────
DEVICE_ID=esp32-s3
# 시리얼 ESP32가 한쪽 레일만 있을 때: left | right (나머지 쪽은 시연 더미)
SERIAL_RAIL_SIDE=left

# ── RBF 레일 변형 예측 모델 가중치 경로 ───────────────────
# python ml/train_rbf_surrogate.py 로 생성
# Docker: 파일 없으면 컨테이너 시작 시 자동 학습
RBF_MODEL_PATH=rbf_dummy_model.pth

# ── 레일 구간 위험도 히트맵 (Godot 디지털 트윈) ───────────
RAIL_LENGTH_CM=100
RAIL_SEGMENT_COUNT=20
