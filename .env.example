# .env.example — 이 파일을 복사하여 .env 로 저장 후 실제 값을 채워주세요.
# cp .env.example .env

# ── 시리얼 포트 설정 ──────────────────────────────────────
# $ ls /dev/cu.*  로 ESP32 포트 이름 확인 후 입력
SERIAL_PORT=/dev/cu.usbmodem1101
BAUD_RATE=115200

# ── InfluxDB 연결 정보 ────────────────────────────────────
# InfluxDB UI → Load Data → API Tokens 에서 토큰 발급
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-api-token-here
INFLUX_ORG=your-org-name
INFLUX_BUCKET=crane_data

# ── 디바이스 식별자 (InfluxDB Tag) ───────────────────────
DEVICE_ID=esp32-s3
