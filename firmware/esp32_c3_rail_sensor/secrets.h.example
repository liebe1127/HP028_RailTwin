#pragma once

// Copy this file to secrets.h and fill in the deployment values.
// Never commit secrets.h.
//
// WiFi is WPA2/WPA3 Personal only: SSID + password.
// That is the right fit for a phone hotspot or a dedicated lab router.
// School/campus WiFi is often WPA2-Enterprise (ID/password/eduroam) or a
// web captive portal. This firmware cannot complete those extra steps.
// Use a phone hotspot for the first MQTT test.

constexpr char WIFI_SSID[] = "your-wifi-ssid";
constexpr char WIFI_PASSWORD[] = "your-wifi-password";
// Use MQTT_LEFT_PASSWORD for the left board and MQTT_RIGHT_PASSWORD for the right.
constexpr char MQTT_PASSWORD[] = "replace-with-node-mqtt-password";
