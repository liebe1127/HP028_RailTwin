#pragma once

// Copy this file to node_profile.h when uploading the RIGHT rail ESP32-C3.
#define RAIL_NODE_RIGHT

constexpr char DEVICE_ID[] = "rail-right-01";
constexpr char RAIL_SIDE[] = "right";

// Change direction to -1 only if forward crane travel decreases encoder position.
constexpr int8_t NODE_ENCODER_DIRECTION = 1;
constexpr float NODE_POSITION_ZERO_OFFSET_MM = 0.0f;
// Set from measured quadrature counts per wheel revolution.
// position_mm remains null while this is zero.
constexpr float NODE_ENCODER_COUNTS_PER_WHEEL_REV = 0.0f;

// Enter the measured resistor values installed on the RIGHT module.
constexpr float NODE_DIVIDER_TOP_OHM = 470'000.0f;
constexpr float NODE_DIVIDER_BOTTOM_OHM = 68'000.0f;
// Enable only after RIGHT LR18 voltage-to-distance calibration.
constexpr bool NODE_ENABLE_LINEAR_DISTANCE_ESTIMATE = false;
